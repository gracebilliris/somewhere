{
  "name": "somewhere",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web --",
    "build": "npm run build -w apps/web",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "preview": "npm run preview -w apps/web --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:pwa": "node tests/pwa.mjs"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.3"
    },
    "deepmerge": "4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.56.1",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0"
  }
}
